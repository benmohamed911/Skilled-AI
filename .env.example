# Copy this file to ".env.local" and fill in the values.

# Accounts and database (Supabase -> Connect). Both values are safe to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI study plans (console.anthropic.com). SECRET: never share or commit this.
# Without it, Pro users get a simpler built-in plan.
ANTHROPIC_API_KEY=
